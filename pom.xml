<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <groupId>com.ctrip.hotel</groupId>
    <artifactId>garfield-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Garfield</name>
    <description>Multi-storage orchestration framework with leader/follower routing and eventual consistency</description>

    <modules>
        <module>garfield-common</module>
        <module>garfield-engine</module>
        <module>garfield-transfer</module>
        <module>garfield-process</module>
        <module>garfield-spring-boot-starter</module>
        <module>garfield-example</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <garfield.version>1.0.0</garfield.version>
        <spring-boot.version>4.0.6</spring-boot.version>
        <!-- Override super-pom's built-in Spring 4.3.4.RELEASE; Spring Boot 3.2.5 requires Spring Framework 6.1.x -->
        <spring.version>6.1.6</spring.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <redisson.version>3.27.2</redisson.version>
        <lombok.version>1.18.42</lombok.version>
        <jackson.version>2.17.0</jackson.version>
        <slf4j.version>2.0.12</slf4j.version>
        <jedis.version>5.1.2</jedis.version>
        <kafka.version>3.7.0</kafka.version>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.ctrip.hotel</groupId>
                <artifactId>garfield-common</artifactId>
                <version>${garfield.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ctrip.hotel</groupId>
                <artifactId>garfield-engine</artifactId>
                <version>${garfield.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ctrip.hotel</groupId>
                <artifactId>garfield-transfer</artifactId>
                <version>${garfield.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ctrip.hotel</groupId>
                <artifactId>garfield-process</artifactId>
                <version>${garfield.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ctrip.hotel</groupId>
                <artifactId>garfield-spring-boot-starter</artifactId>
                <version>${garfield.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
